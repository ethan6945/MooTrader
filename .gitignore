# ============== Secrets — NEVER commit these ==============
.env
.env.local
.env.*.local
*.pem
*.key
# (.env.example IS tracked — it's the template, no real values)
!.env.example

# ============== Runtime / generated data ==============
# Live trade history, balances, open positions, audit logs.
# Everything in data/ is per-machine state; keep template only.
data/*
!data/.gitkeep

# Logs
logs/*
!logs/.gitkeep
*.log

# Backups
*.bak

# ============== Python ==============
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/

# Virtualenv
.venv/
venv/
env/
ENV/

# pytest / coverage / linters
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
.mypy_cache/

# ============== macOS / Windows / IDE ==============
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Claude Code local settings
.claude/settings.local.json

# ============== Optional: keep config templates in repo ==============
# (config/watchlist.json IS tracked — auto-refreshes weekly)
config/watchlist.json.bak

# ============== Compiled / temp ==============
*.tmp
*.temp
