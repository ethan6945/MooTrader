# ===== MooMoo OpenD (headless, auto-started by start-scheduler.command) =====
MOO_HOST=127.0.0.1
MOO_PORT=11111
MOO_TRADE_PWD=your_6_digit_trade_password        # moomoo trade password (set in app)
MOO_TRADE_ENV=SIMULATE        # SIMULATE = paper trading, REAL = live money
MOO_MARKET=US                 # US / HK / CN / SG
MOO_SECURITY_FIRM=FUTUMY      # FUTUMY (Malaysia) / FUTUINC (US) / FUTUSG / FUTUSECURITIES (HK) / FUTUAU / FUTUCA / FUTUJP

# OpenD-rs auto-start credentials (used by start-scheduler.command)
# These are your moomoo APP login credentials, NOT the trade password above.
# First time: run `futu-opend --setup-only --login-account X --login-pwd Y --platform moomoo`
# to complete SMS verification. After that, these env vars suffice for auto-start.
OPEND_LOGIN_ACCOUNT=your_moomoo_account    # phone (+1-xxx) / email / moomoo ID
OPEND_LOGIN_PWD=your_moomoo_password       # moomoo app login password

# ===== AI provider — DeepSeek only =====
# ai.PROVIDERS has been ("deepseek",) since 2026-07-22; Gemini was removed as a
# selectable engine and AI_PROVIDER is clamped to deepseek whatever it says here.
# The model is just a DEFAULT: the web panel writes a runtime override (db-state)
# that wins with NO restart, and the dropdown is fetched LIVE from the provider
# so a newly released model is selectable without a code change. DeepSeek is
# text-only, so the chart-vision confirmation layer stays off.
AI_PROVIDER=deepseek

# Gemini vars are kept only so re-adding the engine is a one-line revert. The
# helper functions still exist but are unreachable; leaving these blank is normal.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.5-flash

# DeepSeek (OpenAI-compatible REST; text-only). https://platform.deepseek.com
DEEPSEEK_API_KEYS=               # comma-separated ok (DEEPSEEK_API_KEY also accepted)
# 2026-08-07: `deepseek-chat` and `deepseek-reasoner` were RETIRED on 2026-07-24
# 15:59 UTC with no soft-redirect — a request naming one fails outright. Current
# IDs are deepseek-v4-flash and deepseek-v4-pro. ai.migrate_deepseek_model()
# rewrites the old names at call time so a stale .env keeps working, and preflight
# flags it, but set a current name here.
#   deepseek-v4-flash — fast and cheap; what every layer in this bot wants (a
#                       short JSON verdict on a latency budget)
#   deepseek-v4-pro   — reasoning model, thinking ON by default, materially
#                       slower and dearer per call. The entry path already
#                       measured median 42s / p90 99s BEFORE reasoning existed,
#                       and NEWS_DRIVEN_BUDGET=12 means up to 12 calls a scan.
DEEPSEEK_MODEL=deepseek-v4-flash

# NOTE: the legacy per-task model vars below (GAP_SENTINEL_MODEL / SMART_EXIT_MODEL
# / SENTIMENT_MODEL / PATTERN_VISION_MODEL) are now UNUSED — one global model
# (the dropdown selection) drives every AI call.

# ===== Tavily (news context for the AI) =====
TAVILY_API_KEY=                  # https://app.tavily.com — free tier 1000/mo

# ===== Telegram (signal + status notifications) =====
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Risk Settings =====
ACCOUNT_USD=4500                 # YOUR BUDGET — bot will never invest above this
RISK_PER_TRADE=0.02              # 2% per trade (auto-tuned by adaptive_sizing)
MAX_POSITIONS=10                 # 10 concurrent positions
MAX_POSITION_PCT=0.40            # per-stock cap — 2026-06-12 ablation optimum; auto-tunable in [0.20, 0.55]
DAILY_DRAWDOWN_STOP=0.03         # halt trading if -3% intraday

# ===== Drawdown Circuit Breaker =====
DD_SIZE_CUT_PCT=10.0             # halve qty when account DD ≥ 10%
DD_HALT_PCT=15.0                 # halt new entries when DD ≥ 15%

# ===== Auto-compounding budget ("money making more money") =====
# When ON, the deployable budget GROWS as the bot's realized profit rises above
# the line where compounding was armed, and SHRINKS in drawdown — so a validated
# edge compounds geometrically. Runs daily after the close, every change is
# Telegram-notified, and the DD breaker is unaffected (equity anchors to the
# frozen seed). Arm/disarm/monitor from the web panel too. DEFAULT OFF.
AUTO_BUDGET_ENABLED=false        # flip true (or use the web toggle) to arm
AUTO_BUDGET_REINVEST_FRAC=1.0    # 1.0 = full reinvest (symmetric press-winners/cut-losers); <1 banks the rest
AUTO_BUDGET_MIN_FRAC=0.5         # floor: never de-risk the budget below seed×0.5
AUTO_BUDGET_MAX_MULT=5.0         # ceiling: never let the budget exceed seed×5 (live equity also caps it)
AUTO_BUDGET_MIN_STEP_USD=250     # hysteresis: ignore moves smaller than max($250, 5%×budget)
AUTO_BUDGET_MIN_STEP_PCT=0.05

# ===== Bear-market cash-yield sweep ("petty money in bad markets") =====
# In a BEAR regime (strategy paused) park idle cash in a T-bill ETF (~4-5%/yr,
# near-zero risk) instead of earning 0%, and unwind to cash when tradeable
# again. Conservative: only sweeps in BEAR so it never starves a real entry.
CASH_YIELD_ENABLED=false         # flip true (or web toggle) to activate
CASH_YIELD_SYMBOL=SGOV           # T-bill ETF (SGOV ~$100, or BIL); must be moomoo-tradeable
CASH_YIELD_ONLY_BEAR=true        # true = sweep only in BEAR (safest); false = sweep any idle cash
CASH_YIELD_BUFFER_USD=500        # always keep this much cash liquid (unswept)
CASH_YIELD_MIN_TRADE_USD=500     # ignore sweeps smaller than this (no dust trades)

# ===== Inverse-ETF sleeve (profit from downtrends — NOT VALIDATED, default OFF) =====
# Buys an inverse ETF when a downtrend is CONFIRMED (BEAR + inverse ETF above its
# own SMA), exits on trend/regime end or stop/TP/max-hold. A small sleeve only.
# ⚠ Can lose money in a new way. Leave OFF until you run:
#     .venv/bin/python -m scripts.inverse_sleeve_backtest
# and it clears the gate (beats SGOV-on-deployed-days without silly drawdown).
INVERSE_SLEEVE_ENABLED=false
INVERSE_SLEEVE_SYMBOL=SH          # SH = -1x S&P (mild decay) | SQQQ = -3x Nasdaq (heavy decay)
INVERSE_SLEEVE_MAX_PCT=0.25       # cap sleeve at this fraction of budget
INVERSE_SLEEVE_SL_ATR=2.5         # ATR stop multiple
INVERSE_SLEEVE_TP_ATR=6.0         # ATR take-profit multiple
INVERSE_SLEEVE_SMA_LEN=20         # trend filter on the inverse ETF
INVERSE_SLEEVE_ATR_LEN=14
INVERSE_SLEEVE_MAX_HOLD_DAYS=30

# ===== Smart regime sensing (VIX-aware + whipsaw hysteresis) =====
# Richer regime telemetry (vix/strength/sub_label) is ALWAYS computed (harmless).
# This flag controls ONE behavior change: gate entry-block + cash-yield + inverse
# sleeve on the hysteresis-SMOOTHED regime instead of the raw 200-MA cross, so a
# single grazing close doesn't whipsaw you in/out of BEAR. Validate first:
#     .venv/bin/python -m scripts.smart_regime_diagnose
# (measured −89% regime flips over 485d, BEAR days barely changed). DEFAULT OFF.
SMART_REGIME_ENABLED=false

# ===== Scoring & Timeframe (Optuna-tuned 180d) =====
ENTRY_SCORE_THRESHOLD=60         # 0-100, only enter if score ≥
SCAN_INTERVAL_MIN=30             # scan every N minutes
MAX_HOLD_DAYS=5                  # force-close positions older than N days
TIMEFRAME=HOUR_1                 # HOUR_1 (live frame). DAILY trading mode removed 2026-06-07 (HOUR_1 won backtests).

# ===== Exit & Gap Knobs (Optuna-tuned) =====
TP_ATR_MULT=3.0                  # take-profit = entry + 3.0 × ATR
SL_ATR_MULT=3.25                 # stop-loss   = entry - 3.25 × ATR
MAX_GAP_PCT=2.5                  # block entry if overnight gap > 2.5%

# ===== Entry-extension gate (replaces the fixed 20bps chase tolerance) =====
# The legacy gate skips when the live quote is >20bps above the signal bar close.
# That threshold is scale-dependent for no good reason: 20bps is $0.10 on a $50
# name and $2.80 on a $1,400 one, while what decides whether the setup is intact
# is the move measured in the name's OWN volatility. On 2026-08-04 it blocked an
# 80-score HPE entry six scans running across a $51.88-$52.50 range.
# The replacement asks two scale-invariant questions at the LIVE price:
#   1. extension = (live - signal) / ATR   — how far past the setup are we?
#   2. reward/risk, using the structural stop when the strategy supplied one
#      (an ATR-only R:R is a constant and tests nothing).
# MODES: legacy = old gate only. shadow = old gate decides, new one logs what it
# WOULD have done. atr = new gate decides (and the entry limit is then priced at
# the live quote, since the whole point is it may sit above the stale signal).
# DEFAULT shadow. This gate exists only in the live path — the backtest fills at
# the next bar open and never sees a live quote — so it CANNOT be validated by a
# backtest run. Shadow mode is how it earns its evidence: zero behaviour change,
# both verdicts in the log. Read those lines before switching to atr.
ENTRY_EXTENSION_MODE=shadow
ENTRY_MAX_EXTENSION_ATR=0.5      # skip when live is more than this many ATR past the signal
ENTRY_MIN_RR=1.5                 # skip when reward/risk at the live price falls below this

# ===== Regime Up-Scaling (tailwind press) =====
# Boost position size ONLY in a confirmed strong bull (SPY>50>200MA) AND calm
# VIX (< REGIME_VIX_CALM). 1.0 = off (no change). 1.4 = conservative boost
# (140d/$5k backtest: a few % more $/day, drawdown flat). Higher multipliers
# (2×+) were over-fit noise on ~40 trades — don't chase them. Mirrored by the
# honest backtest engine so live ↔ backtest stay in parity. Still obeys the
# per-stock cap (MAX_POSITION_PCT), so it can't breach concentration limits.
REGIME_BULL_MULT=1.0
REGIME_VIX_CALM=20

# ===== Gap-Risk Sentinel (held-position pre-gap exit) =====
# A stop-loss CANNOT catch an overnight gap (it fills past the stop), so this
# exits a held name DURING regular hours when it carries a known gap-down
# catalyst. Layer 1 (deterministic): exit if earnings is within
# GAP_EXIT_EARNINGS_DAYS. Layer 2 (AI, needs GEMINI_API_KEYS): Gemini sells only
# on concrete public bad news at confidence ≥ GAP_SENTINEL_AI_MIN_CONF, and is
# FAIL-SAFE (holds on any error/doubt — never sells on an unknown). The AI
# decision overrides the strategy's hold; every exit fires a Telegram alert.
# 1=on. Off by default. NOTE: this is the *catalyst* defense; position SIZING
# (MAX_POSITION_PCT) is still the real protection against surprise gaps.
GAP_SENTINEL_ENABLED=false
GAP_EXIT_EARNINGS_DAYS=1
GAP_SENTINEL_AI=true
GAP_SENTINEL_AI_MIN_CONF=70
# GAP_SENTINEL_MODEL: one fixed Gemini model for the gap check. Owner preference
# is Gemini ≥ 3.5-flash everywhere (no lite tiers). GAP_SENTINEL_AI_INTRADAY=false
# → AI runs PRE-MARKET only (the ~11 per-scan AI calls/day are skipped; the free
# deterministic earnings layer still runs each scan). The AI call is also skipped
# whenever there's no fresh news, so cost stays bounded even on 3.5-flash.
GAP_SENTINEL_MODEL=gemini-3.5-flash
GAP_SENTINEL_AI_INTRADAY=false

# ===== Smart exit (AI/algo intraday early-exit) =====
# Exit a HELD long during the day when it turns bearish: concrete bad news /
# analyst downgrade (AI), or a technical break-down while in profit (algo
# lock-profit). Runs on the 5-min manage tick, reuses the gap-sentinel exit
# path. DEFAULT OFF; FAIL-SAFE (AI down → no exit). SMART_EXIT_AI=false keeps
# only the deterministic lock-profit (no Gemini cost). MIN_PROFIT_R gates the
# algo lock-profit so a barely-green trade isn't cut on a wobble (AI news path
# ignores it — concrete bad news exits at any P&L).
SMART_EXIT_ENABLED=false
SMART_EXIT_AI=true
SMART_EXIT_MIN_CONF=70
SMART_EXIT_MIN_PROFIT_R=1.0
SMART_EXIT_MODEL=gemini-3.5-flash

# ===== Sentiment scoring (moomoo-style 看好/看空) =====
# Per buy candidate, Gemini fuses news + analyst-target direction + the computed
# technical signals into a 0-100 bullishness score (50=neutral). DEFAULT OFF and
# ADVISORY (recorded + shown on the card, does NOT change which trades fire).
# SENTIMENT_SIZING=true also folds the score into position sizing (conviction),
# still never changing selection. FAIL-SAFE → neutral 50. Per-scan call budget.
SENTIMENT_SCORING_ENABLED=false
SENTIMENT_SIZING=false
SENTIMENT_MODEL=gemini-3.5-flash
SENTIMENT_BUDGET=8

# ===== News search quality (Tavily) =====
# The single highest-leverage knob on news quality. Tavily's news topic searches
# the open web, so it returns SEO listicles ("3 AI stocks to watch"), aggregator
# rewrites and price-move recaps next to real reporting — all of which read as
# catalysts to a model and are none. Empty = open web (default, unchanged).
# `recommended` = the major financial wires + sec.gov, where an 8-K IS the
# material event, timestamped, before the press writes it up. Or list your own.
NEWS_INCLUDE_DOMAINS=            # empty | recommended | reuters.com,sec.gov,...
# basic | advanced. advanced extracts content better and costs more credits.
NEWS_SEARCH_DEPTH=basic
# Per-ticker lookback in days. 3 is the historical default and is exactly why the
# input is a narrative rather than an event; 1 suits a same-session bet.
NEWS_TICKER_DAYS=3

# ===== News-driven mode (新闻主导) — the one switch that inverts the funnel =====
# Everything else AI-shaped in this file is advisory: the technical rule score
# decides WHICH trade fires, which is what keeps the backtest a description of
# the live system. Turn this on and that flips — the rule score demotes to a
# "is this tradeable at all" prefilter, and the AI news read selects and sizes.
#
# READ BEFORE ARMING:
#  • THE BACKTEST STOPS DESCRIBING LIVE. sandbox.py deliberately skips AI (LLM
#    look-ahead), so with this on the two run different strategies. Backtest
#    numbers cannot tell you whether this mode works.
#  • The news is up to 3 days old (Tavily days=3, 30-min cache). This trades a
#    narrative, not an event — it is NOT a fast-news edge, and any move the
#    headline caused is already in the price.
#  • No factor study backs it, unlike the options-volume factor (5,980
#    name-days). Live results ARE the experiment. Size accordingly.
#  • FAIL-SAFE INVERTS: no key / no news / quota error → NO TRADE (not "fall
#    back to technicals", which would silently be a different strategy).
NEWS_DRIVEN_ENABLED=false
# 0-100 news bullishness needed to enter (50 = neutral).
NEWS_DRIVEN_MIN_SCORE=65
# Require a NAMED catalyst (guidance raise, contract, upgrade, approval…), not
# just a warm tone. Off ⇒ an LLM mood score picks your trades. Keep it on.
NEWS_DRIVEN_REQUIRE_CATALYST=true
# How much to relax the rule-score bar (negative = looser). Never goes below 50.
NEWS_DRIVEN_THRESHOLD_DELTA=-10
# Score → size: MIN_SCORE maps to 1.0x, 100 maps to this. max_position_pct still caps.
NEWS_DRIVEN_MAX_MULT=1.5
# Per-scan AI read budget. Higher than SENTIMENT_BUDGET because here an unread
# name cannot trade at all; when it runs out the scan stops opening positions.
NEWS_DRIVEN_BUDGET=12
# 收盘平仓: flatten every bot-managed position before the close, so a
# news-driven bet never carries overnight. Note this caps the trade at one
# session while the documented post-news drift (PEAD) runs for days.
NEWS_DRIVEN_EOD_FLATTEN=true
NEWS_DRIVEN_FLATTEN_ET=15:45
# Stop opening NEW positions this many minutes before the flatten, so the bot
# doesn't pay a round trip for five minutes of exposure. Default ⇒ last new
# entry 15:15 ET.
NEWS_DRIVEN_MIN_HOLD_MIN=30

# ===== Options flow (期权异动) — BLOCKED until you subscribe =====
# Detects volume≫open-interest, put/call skew, OI-concentration support/resistance.
# Your account currently has NO US options quote permission, so the API denies the
# data and this stays neutral. Subscribe to moomoo US options market data first;
# then turn this on and 2A/2B can consume it. DEFAULT OFF (scaffold, untested).
OPTIONS_FLOW_ENABLED=false

# ===== Options AGGREGATE stats (src/options_stats.py) =====
# The chain above is blocked, but three UNDERLYING-level endpoints answer without
# the options quote subscription — including one with a year of daily call/put
# volume. Measured 2026-08-05 over 5,980 name-days: call volume vs its own 20d
# mean sorts forward returns monotonically (rvol>=3 -> 61.6% win / +3.058%
# next-3-day vs a 53.8% / +1.240% baseline), while the put/call RATIO is flat —
# the skew carries no direction, only the volume does. Earnings days are excluded
# (39% of spikes sit in one, at ~2x the volatility); excluding them improves the
# signal to 63.8% win / +2.559% on n=105, positive in both half-year sub-periods.
# CAVEAT: the broker caps history at 251 rows, so that whole sample is ONE BULL
# MARKET. This has never been observed in a drawdown. Validate with
#   .venv/bin/python -m scripts.options_factor_study
# ENABLED alone is advisory: logged + persisted on every buy, never changes which
# trade fires (live<->backtest parity holds). SIZING is the separate opt-in that
# lets a spike scale position size UP; it can never veto a quiet name.
OPTIONS_STATS_ENABLED=false
OPTIONS_STATS_SIZING=false
OPTIONS_STATS_MIN_RVOL=2.0       # call volume / its own 20d mean, above which the day counts as a spike
OPTIONS_STATS_MAX_MULT=1.15      # max conviction boost when SIZING is armed

# ===== API/subscription health watchdog =====
# Telegram-alerts you when a silent dependency lapses: the moomoo options data
# subscription (can't fetch chains) or the Gemini API balance/quota (AI goes
# blind — the cascade is single-model, no silent downgrade, so an exhausted key
# = AI off until you top up). Edge-triggered (alerts only on a state CHANGE, no
# spam). DEFAULT ON. Runs every interval minutes + once at startup.
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL_MIN=30

# ===== Pattern strategy (chart-pattern recognition) =====
# A 4th strategy: geometric + candlestick chart patterns (double bottom,
# triangles, inverse H&S, wedges, flags, range breakout, hammer/engulfing/
# morning-star) scored on the same 0-100 scale and fed through the SAME funnel.
# DEFAULT OFF — same discipline as MR_ENABLED / GAP_SENTINEL: turn on ONLY after
# `python -m src.backtest_v3` (with PATTERN_ENABLED=true) validates an edge.
PATTERN_ENABLED=false
# Admission filters — narrow WHICH detections may become entries. The unfiltered
# set was net-negative on the 180d backtest (weak breakouts catching false tops),
# so tighten before enabling. PATTERN_ALLOWED_TYPES: csv of detector names
# (double_bottom, ascending_triangle, symmetric_triangle, inverse_head_shoulders,
# falling_wedge, bull_flag, range_breakout, hammer, bullish_engulfing,
# morning_star); empty = all. Defaults below are inert (no filtering).
PATTERN_MIN_CONFIDENCE=0
PATTERN_REQUIRE_TRIGGERED=false
PATTERN_ALLOWED_TYPES=
# AI VISION confirmation: render the candle chart and ask Gemini to confirm the
# algo-detected pattern (the "AI" half). Live-only (skipped in backtest) and
# FAIL-SAFE (vision unavailable → pass), so it never silently kills a signal.
PATTERN_VISION_ENABLED=false
# Advisory by default (logged + shown on the buy card). Set blocking=true to let
# a high-confidence 'reject' (conf ≥ PATTERN_VISION_REJECT_CONF) veto the entry.
PATTERN_VISION_BLOCKING=false
PATTERN_VISION_REJECT_CONF=60
# Vision model (owner wants Gemini ≥ 3.5-flash everywhere) + per-scan call budget.
PATTERN_VISION_MODEL=gemini-3.5-flash
PATTERN_VISION_BUDGET=8

# ===== Autonomous Optimizer =====
# The weekly self-review feeds REAL fills to Gemini (the same GEMINI_MODEL above —
# system unified on Gemini 3.5 Flash, DeepSeek removed 2026-06-08), which proposes
# small param tweaks (entry threshold / tp / sl). EACH proposal is then backtested
# on the honest engine (180d + 360d) and only queued for YOUR approval if it beats
# baseline $/day WITHOUT worsening drawdown. It never auto-applies. No extra key —
# it uses GEMINI_API_KEYS; with none set the optimizer falls back to rules only.

# (ML alpha engine removed 2026-06-03 — proven inert on this universe, AUC ≈ 0.5.)

# ── v2.0 Autopilot (2026-06-11) ──────────────────────────────────────────
DYNAMIC_UNIVERSE_ENABLED=true    # weekly rule-based top-N universe (src/universe.py)
UNIVERSE_TOP_N=15                # plateau-validated 10-20
UNIVERSE_SECTOR_CAP=5            # max names per sector bucket in the top-N (0=off) — 07-15 lesson: pure momentum picked 15/15 semis and the book crashed as one trade
# Reserve N of the top-N slots for the pool's sector ETFs (0=off). Fixes position
# GRANULARITY, not signal: at $10k with a 20% cap one share of SNDK ($1,428) is
# 14% of the book and the ATR share count floors to 1 or 0, so size becomes
# all-or-nothing and the risk model stops working. SMH/SOXX carry the same
# exposure at 3 shares. Measured 2026-08-05: at 0 the ETFs never out-rank on 6-1
# momentum, so the pool addition alone changes NOTHING; at 2 the watchlist swaps
# INTC+STX for SOXX+SMH (the sector cap is what picks who leaves).
UNIVERSE_ETF_SLOTS=0
AUTO_APPLY_PARAMS=true           # gate-passed proposals inside ALLOWED_PARAMS auto-apply + notify; auto-rollback on degradation
USE_BREAKEVEN_STOP=true          # +1R breakeven ratchet (validated: PF/DD/PnL all improved)
BREAKEVEN_TRIGGER_R=1.0
STALL_OUT_ENABLED=false          # keep off until the engine models it (exit parity)

# Universe refresh cadence + hysteresis (src/universe.py)
# weekly = recompute the watchlist Mon 20:05 KL (default). daily = every session.
# UNIVERSE_EXIT_RANK adds a band: enter at rank<=UNIVERSE_TOP_N, leave only once
# rank>UNIVERSE_EXIT_RANK. <=top_n disables it.
# MEASURED 2026-08-06 over 40 sessions (top_n=15, etf_slots=2):
#     daily, no hysteresis   45 changes /  8 net rotations  = 5.6x churn
#     daily, 15 in / 20 out  29 changes /  6 net rotations  = 4.8x churn
#     weekly (default)       16 changes /  6 net rotations  = 2.7x churn
# Hysteresis cuts daily churn by 36%, but WEEKLY IS STILL CLEANER — it buys the
# same rotations for half the turnover. Daily reaches a different end state (8 of
# 15 names differ), so whether it is better is a P&L question the churn metric
# cannot answer; run the backtest both ways before switching.
# WARNING: a non-zero exit rank makes selection PATH-DEPENDENT. Live threads the
# shipped watchlist through as `previous`; backtest_v3 and sandbox thread their
# own. Change one without the others and the replay silently stops matching live.
UNIVERSE_REFRESH_FREQ=weekly
UNIVERSE_EXIT_RANK=0
